<UserControl x:Class="CMPDriverTool.App.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CMPDriverTool.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallerViewModel}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Процесс установки драйвера" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding DriverVersion, StringFormat='Версия: NVIDIA GeForce v{0} (Gaming Mod TU116/TU106)'}"
                           FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="← На главный экран"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReturnToDashboardCommand}"
                    IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>

        <!-- Visual Step Indicators -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Margin="0,0,0,16">
            <StackPanel>
                <!-- 6 Step badges row -->
                <UniformGrid Columns="6" Margin="0,0,0,16">
                    <!-- Step 1 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="1. Загрузка" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Скачивание" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step1Download}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step1Download}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step1Download}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="2. Распаковка" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="7-Zip / SFX" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step2Extract}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step2Extract}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step2Extract}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="3. Debloat" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Без телеметрии" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step3Debloat}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step3Debloat}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step3Debloat}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 4 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="4. Патчинг INF" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="nvami.inf" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step4PatchInf}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step4PatchInf}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step4PatchInf}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 5 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="5. Сертификат" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Тестовая подпись" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step5Certificate}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step5Certificate}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step5Certificate}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 6 -->
                    <Border Margin="4,0" Background="#1C1C20" CornerRadius="6" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="6. Установка" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="NVIDIA Setup" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step6Install}" Value="Active">
                                                <Setter Property="Text" Value="🔄" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step6Install}" Value="Success">
                                                <Setter Property="Text" Value="✅" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Step6Install}" Value="Failed">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Status Text and Progress Bar -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding CurrentStepTitle}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:F0}%'}"
                               HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentNvidia}" />
                </Grid>

                <TextBlock Text="{Binding CurrentStepMessage}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                <!-- Progress Bar -->
                <ProgressBar Height="10"
                             Value="{Binding OverallProgress}"
                             Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Foreground="{StaticResource AccentNvidia}"
                             Background="#1C1C20"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- Operation Log Section (Expandable) -->
        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Подробный лог операций (pnputil / patcher):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Command="{Binding ToggleLogExpandedCommand}"
                            Padding="10,3" FontSize="11" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Content" Value="Свернуть лог ▲" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogExpanded}" Value="False">
                                        <Setter Property="Content" Value="Развернуть лог ▼" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" Content="📋 Скопировать лог"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,2" FontSize="11"
                            Command="{Binding CopyLogCommand}" />
                </Grid>

                <!-- Log Output Box (Collapsible) -->
                <ListBox Grid.Row="1"
                         x:Name="LogListBox"
                         ItemsSource="{Binding LogLines}"
                         Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                         MinHeight="160"
                         Background="#121214"
                         BorderBrush="#28282E"
                         Foreground="#D4D4D8"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer Control Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Reboot Prompt if Completed -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⚠️ Для полноценного применения изменений требуется перезагрузка ПК."
                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="🔄 Перезагрузить сейчас"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RebootComputerCommand}" />
            </StackPanel>

            <!-- Test Mode Failure Action -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsTestModeFailure, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⚠️ Windows требует Test Mode для модифицированного драйвера."
                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="🔧 Включить Test Mode и перезагрузить ПК"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding EnableTestModeAndRebootCommand}" />
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📂 Папка с драйвером"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{Binding OpenDriverFolderCommand}"
                        ToolTip="Открыть папку с распакованным и модифицированным драйвером NVIDIA" />

                <Button Content="⚡ Запустить setup.exe"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Command="{Binding LaunchSetupExeManualCommand}"
                        ToolTip="Запустить официальный графический мастер установки NVIDIA" />

                <Button Content="Отменить установку"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Command="{Binding CancelInstallCommand}"
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />

                <Button Content="Готово (В меню)"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ReturnToDashboardCommand}"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />

                <Button Content="← На главный экран"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ReturnToDashboardCommand}"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
