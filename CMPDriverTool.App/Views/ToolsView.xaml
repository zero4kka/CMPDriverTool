<UserControl x:Class="CMPDriverTool.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CMPDriverTool.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Системные инструменты и обслуживание" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Перезапуск видеодрайвера, настройка тестового режима Windows и очистка старых пакетов"
                               FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="🛠 Диспетчер устройств"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenDeviceManagerCommand}" />
            </Grid>

            <!-- Grid of 2 Top Action Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Restart GPU Driver -->
                <Border Grid.Column="0" Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="Перезапуск видеодрайвера (Win+Ctrl+Shift+B)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock Text="Программная отправка горячей комбинации Windows для сброса и перезапуска DWM (Desktop Window Manager) и WDDM-драйвера видеокарты без перезагрузки системы."
                                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" />

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="40"
                                Command="{Binding RestartDriverCommand}"
                                IsEnabled="{Binding IsRestartingDriver, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ Перезапустить видеодрайвер сейчас" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CARD 2: BCDEDIT Test Mode -->
                <Border Grid.Column="2" Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="Тестовый режим Windows (Testsigning)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock Text="Включение/отключение проверки цифровой подписи драйверов в загрузчике Windows (bcdedit.exe). Необходим для загрузки кастомных драйверов с тестовым сертификатом."
                                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />

                        <Border Background="#1C1C20" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding TestModeStatus}" FontWeight="SemiBold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestModeEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TestModeEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="40"
                                Command="{Binding ToggleTestModeCommand}"
                                IsEnabled="{Binding IsChangingTestMode, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="🔄 Переключить режим Testsigning (on/off)" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Guide Card: PCIe SMD Capacitors modding for CMP cards -->
            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Справка: Восстановление линий PCIe (SMD-конденсаторы 0.1 мкФ)" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Почему видеокарта CMP работает в x1 и как распаять недостающие конденсаторы"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ToggleCapacitorGuideCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Content" Value="Развернуть справку ▼" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCapacitorGuide}" Value="True">
                                            <Setter Property="Content" Value="Свернуть справку ▲" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowCapacitorGuide, Converter={StaticResource BoolToVis}}">
                        <Border Background="#1C1C20" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Причина проблемы:" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Многие производители майнинг-карт CMP 30HX и CMP 40HX (Gigabyte, Palit, Colorful и др.) экономили на производстве печатных плат и распаивали только первую линию данных PCIe (Lane 0). На контактах остальных линий (Lanes 1-15) посадочные места под разделительные керамические SMD-конденсаторы оставлены пустыми."
                                           TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10" />

                                <TextBlock Text="Последствия в играх:" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="В режиме PCIe x1 пропускная способность шины ограничена ~250-985 МБ/с (в зависимости от поколения PCIe 1.1 / 2.0 / 3.0). При подгрузке текстур и шейдеров в играх это вызывает сильные статтеры, падение времени кадра и резкие микрофризы."
                                           TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10" />

                                <TextBlock Text="Как исправить (Модификация паяльником):" FontWeight="Bold" Foreground="{StaticResource AccentNvidia}" Margin="0,0,0,4" />
                                <TextBlock Text="1. Потребуются керамические SMD-конденсаторы ёмкостью 0.1 мкФ (100 нФ), номинальное напряжение от 10В до 16В, типоразмер 0402 (или 0603 в зависимости от платы).&#x0a;2. Найдите на печатной плате ряд пустых контактных площадок возле ножевого разъема PCIe (линии передачи TX/RX).&#x0a;3. Припаяйте недостающие конденсаторы тонким жалом или термовоздушным феном с флюсом.&#x0a;4. После запайки плата определится в режиме PCIe 3.0 x16 (или x8 / x4 в зависимости от кристалла) и фризы в играх полностью исчезнут."
                                           TextWrapping="Wrap" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CARD: GPU Display Name in Task Manager & Device Manager -->
            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Отображаемое имя видеокарты (Диспетчер задач и устройств)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6" />
                    <TextBlock Text="Мгновенно изменяет название видеокарты в системе (вкладка «Производительность -> Графический процессор» в Диспетчере задач, Диспетчер устройств и игры) без переустановки драйвера."
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" />

                    <!-- Current Name -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Текущее имя в системе:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentInstalledGpuName}" FontWeight="SemiBold" Foreground="{StaticResource AccentNvidia}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Presets ComboBox and Apply Button -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Новое имя видеокарты:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding GpuNamePresets}"
                                  SelectedItem="{Binding SelectedGpuNameOption}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#1E1E22" />
                                    <Setter Property="Foreground" Value="#F4F4F5" />
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Margin="2,1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#33333A" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2D3E1A" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#F4F4F5" FontSize="13" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Content="⚡ Применить имя"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36"
                                Padding="16,0"
                                Margin="12,0,0,0"
                                Command="{Binding ApplyGpuRenameCommand}"
                                IsEnabled="{Binding IsRenamingGpu, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <!-- Custom Name TextBox -->
                    <Border Background="#1C1C20" CornerRadius="6" Padding="12" Margin="0,0,0,4"
                            Visibility="{Binding IsCustomGpuName, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Своё название:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomGpuNameText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#141416"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#3F3F46"
                                     Padding="8,6"
                                     FontSize="13" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD 3: Clean up installed OEM Display Drivers via pnputil -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Управление пакетами драйверов (DriverStore / pnputil)" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Удаление старых конфликтующих OEM-пакетов видеодрайверов NVIDIA из системного хранилища"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="🔄 Сканировать DriverStore"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshDriversCommand}"
                                IsEnabled="{Binding IsScanningDrivers, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <!-- Big 1-Click Clean Uninstall Button -->
                    <Border Margin="0,0,0,12" HorizontalAlignment="Left">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Height="36" Padding="14,4"
                                Command="{Binding CleanAllDriversCommand}"
                                IsEnabled="{Binding IsScanningDrivers, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹 Удалить ВСЕ драйверы NVIDIA в 1 клик" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <ListBox ItemsSource="{Binding InstalledDrivers}"
                             MaxHeight="260"
                             Background="#141418"
                             BorderBrush="#2A2A30"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E24" CornerRadius="6" Padding="12,8" Margin="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{Binding IsNvidiaDisplayDriver, Converter={StaticResource StatusToBrush}}">
                                            <TextBlock Text="{Binding PublishedName}" FontWeight="Bold" FontSize="11" Foreground="#09090B" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalName, StringFormat='Исходный файл: {0}'}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding ProviderName, StringFormat='Поставщик: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{Binding DriverVersion, StringFormat='Версия: {0}'}" FontSize="11" Foreground="{StaticResource AccentNvidia}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="🗑 Удалить пакет"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4" FontSize="11"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.UninstallDriverPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
