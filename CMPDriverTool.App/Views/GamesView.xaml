<UserControl x:Class="CMPDriverTool.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CMPDriverTool.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GamesViewModel}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Игры и графические настройки" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Направление 3D-рендера игр на CMP 30HX / 40HX через реестр Windows (HKCU\Software\Microsoft\DirectX\UserGpuPreferences)"
                           FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Добавить игру (.exe)..."
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding AddCustomGameCommand}" />
                <Button Content="🔄 Пересканировать"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshGamesCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Search Bar and Stats -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Margin="0,0,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="13"
                         Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Направлено на CMP: " Foreground="{StaticResource TextSecondary}" FontSize="13" />
                    <TextBlock Text="{Binding CmpAssignedCount}" FontWeight="Bold" Foreground="{StaticResource AccentNvidia}" FontSize="14" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Games.Count, StringFormat='из {0} найденных игр'}" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Games List -->
        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="4">
            <ListBox ItemsSource="{Binding DisplayGames}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4,3" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202024"
                                BorderBrush="#2F2F36"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon / Badge -->
                                <Border Grid.Column="0" Width="36" Height="36"
                                        Background="#2B2B32" CornerRadius="6"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Game Title & Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <Border Margin="8,0,0,0" Background="#2E2E36" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Toggle Switch -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <CheckBox Style="{StaticResource FluentToggleSwitch}"
                                              IsChecked="{Binding IsCmpPreferred, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleCmpPreferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}">
                                        <TextBlock FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="По умолчанию" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCmpPreferred}" Value="True">
                                                            <Setter Property="Text" Value="Рендер на CMP ⚡" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </StackPanel>

                                <!-- Remove custom game button -->
                                <Button Grid.Column="3"
                                        Content="✕"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        ToolTip="Удалить из списка"
                                        Command="{Binding DataContext.RemoveCustomGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status Footer -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,8,0,0" />
    </Grid>
</UserControl>
