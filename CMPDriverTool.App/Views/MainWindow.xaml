<Window x:Class="CMPDriverTool.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CMPDriverTool.App.Views"
        xmlns:vm="clr-namespace:CMPDriverTool.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="20,24,20,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource AccentNvidia}" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#09090B" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="CMP Driver Tool" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="NVIDIA 30HX &amp; 40HX" FontSize="11" Foreground="{StaticResource AccentNvidia}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Buttons -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <!-- Nav Tab 1: Dashboard -->
                    <RadioButton GroupName="NavTabs"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBool}, ConverterParameter=Dashboard, Mode=TwoWay}"
                                 Margin="0,3">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏠" FontSize="15" Margin="0,0,12,0" />
                                                    <TextBlock Text="Главная" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondary}" x:Name="txt" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#24242A" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Nav Tab 2: Installer -->
                    <RadioButton GroupName="NavTabs"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBool}, ConverterParameter=Installer, Mode=TwoWay}"
                                 Margin="0,3">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚙️" FontSize="15" Margin="0,0,12,0" />
                                                    <TextBlock Text="Установка драйвера" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondary}" x:Name="txt" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#24242A" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Nav Tab 3: Games -->
                    <RadioButton GroupName="NavTabs"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBool}, ConverterParameter=Games, Mode=TwoWay}"
                                 Margin="0,3">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎮" FontSize="15" Margin="0,0,12,0" />
                                                    <TextBlock Text="Игры и графика" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondary}" x:Name="txt" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#24242A" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Nav Tab 4: Tools -->
                    <RadioButton GroupName="NavTabs"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBool}, ConverterParameter=Tools, Mode=TwoWay}"
                                 Margin="0,3">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛠️" FontSize="15" Margin="0,0,12,0" />
                                                    <TextBlock Text="Инструменты" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondary}" x:Name="txt" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#24242A" />
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentNvidia}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E24" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Margin="16" Background="#18181C" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Статус системы" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />

                        <!-- CMP status line -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock FontSize="11" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚪" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DashboardVm.IsCmpDetected}" Value="True">
                                                <Setter Property="Text" Value="🟢" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="NVIDIA CMP" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>

                        <!-- Test Mode line -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock FontSize="11" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🟡" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DashboardVm.SecurityInfo.TestModeEnabled}" Value="True">
                                                <Setter Property="Text" Value="🟢" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Test Mode" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>

                        <!-- Secure Boot line -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock FontSize="11" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🟢" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DashboardVm.SecurityInfo.SecureBootEnabled}" Value="True">
                                                <Setter Property="Text" Value="🔴" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Secure Boot" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <!-- View 1: Dashboard -->
            <views:DashboardView DataContext="{Binding DashboardVm}"
                                 Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Dashboard}" />

            <!-- View 2: Installer -->
            <views:InstallerView DataContext="{Binding InstallerVm}"
                                 Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Installer}" />

            <!-- View 3: Games -->
            <views:GamesView DataContext="{Binding GamesVm}"
                             Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Games}" />

            <!-- View 4: Tools -->
            <views:ToolsView DataContext="{Binding ToolsVm}"
                             Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Tools}" />
        </Grid>
    </Grid>
</Window>
